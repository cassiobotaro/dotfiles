# Fonte (Nerd Font instalada pelo install.sh); ligaturas já vêm ligadas
font-family = FiraCode Nerd Font Mono
font-size   = 12

# Cores: fundo preto e paleta ANSI de cores vivas
background           = #000000
foreground           = #dddddd
cursor-color         = #cccccc
cursor-text          = #111111
selection-foreground = #000000
selection-background = #fffacd
palette = 0=#000000
palette = 1=#cc0403
palette = 2=#19cb00
palette = 3=#cecb00
palette = 4=#0d73cc
palette = 5=#cb1ed1
palette = 6=#0dcdcd
palette = 7=#dddddd
palette = 8=#767676
palette = 9=#f2201f
palette = 10=#23fd00
palette = 11=#fffd00
palette = 12=#1a8fff
palette = 13=#fd28ff
palette = 14=#14ffff
palette = 15=#ffffff

# Comportamento
confirm-close-surface  = false
scrollback-limit-lines = 50000
copy-on-select         = false
window-padding-x       = 0
window-padding-y       = 0
# a integração é carregada pelo .zshrc (vale também após `exec zsh`).
# no-title: o título fica só com o que os programas definem
# ssh-*: leva o terminfo do xterm-ghostty pro servidor
shell-integration          = none
shell-integration-features = no-title,ssh-env,ssh-terminfo

# Barra de título e abas (nativas do GNOME) na cor do terminal
window-theme = ghostty

# Splits: escurece os sem foco e divisória cinza
unfocused-split-opacity = 0.7
split-divider-color     = #4a4a4a

# splits, abas e janelas novas já abrem na pasta atual (padrão do Ghostty)
keybind = ctrl+shift+\=new_split:right
keybind = ctrl+shift+-=new_split:down
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+z=toggle_split_zoom

# navegar entre splits estilo vim
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# redimensionar splits estilo vim (move a divisória na direção; em pixels)
keybind = ctrl+alt+h=resize_split:left,50
keybind = ctrl+alt+l=resize_split:right,50
keybind = ctrl+alt+k=resize_split:up,50
keybind = ctrl+alt+j=resize_split:down,50

# ir direto para a aba N (ctrl+shift+1..9)
keybind = ctrl+shift+digit_1=goto_tab:1
keybind = ctrl+shift+digit_2=goto_tab:2
keybind = ctrl+shift+digit_3=goto_tab:3
keybind = ctrl+shift+digit_4=goto_tab:4
keybind = ctrl+shift+digit_5=goto_tab:5
keybind = ctrl+shift+digit_6=goto_tab:6
keybind = ctrl+shift+digit_7=goto_tab:7
keybind = ctrl+shift+digit_8=goto_tab:8
keybind = ctrl+shift+digit_9=goto_tab:9

# scrollback: o Ghostty não tem pager embutido; abre num arquivo temporário
# (para buscar sem sair do terminal: ctrl+shift+f)
keybind = ctrl+shift+space=write_scrollback_file:open,plain

# recarregar config
keybind = ctrl+shift+f5=reload_config
